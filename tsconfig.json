{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/modules/plugins/pi-agent/**",
    "src/modules/plugins/codex-agent/**",
    "src/modules/plugins/antigravity-agent/**",
    "src/modules/plugins/workbench/**",
    "src/modules/plugins/browser/**",
    "src/modules/plugins/turnNotification.test.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
